{
  "$schema": "https://unpkg.com/knip@6.42.1/schema-jsonc.json",
  "ignoreExportsUsedInFile": true,
  "ignore": ["archives/**", ".obsidian/**"],
  "workspaces": {
    ".": {
      // The mise plugin labels task scripts as development entries, which otherwise
      // filters even explicitly declared production roots out of the graph.
      "mise": false,
      "entry": [],
      "project": [
        "**/*.{ts,tsx,js,jsx}!",
        "!**/tests/**!",
        "!**/*.{test,spec}.{ts,tsx,js,jsx}!",
        "!**/fixtures/**!",
        "!herdr-pane.ts!",
        "!**/herdr-pane.ts!",
      ],
      "ignoreDependencies": [
        "knip",
        "oxlint",
        "oxlint-plugin-eslint",
        "oxlint-tsgolint",
        "oxfmt",
      ],
      "ignoreBinaries": ["mise"],
    },
    "obsidian": {
      // Shell and remote launchers invoke these scripts; Obsidian loads the plugin.
      "entry": ["open-vault.ts!", "open-remote.ts!", "forget-shadow.ts!", "local-plugins/doc-view/main.js!"],
      "project": ["**/*.{ts,tsx,js,jsx}!", "!**/*.{test,spec}.{ts,tsx,js,jsx}!"],
    },
    "tools/disk-reclaim": {
      // Bun subprocesses and probe imports use paths constructed at runtime.
      "entry": [
        "src/disk-clean-child.ts!",
        "src/disk-rust-child.ts!",
        "src/disk-tmpfs-child.ts!",
        "src/disk-purge-child.ts!",
        "src/disk-builds-child.ts!",
        "src/disk-scratch-child.ts!",
        "src/disk-ccc-index-db-child.ts!",
        "src/disk-rip-expire-child.ts!",
        "src/disk-workspaces-child.ts!",
        "src/disk-judgment-child.ts!",
        "src/disk-toolchains-worker.ts!",
        "src/disk-capacity.ts!",
        "src/disk-receipts.ts!",
        "src/disk-move-check.ts!",
      ],
      "project": [
        "**/*.{ts,tsx,js,jsx}!",
        "!**/tests/**!",
        "!**/*.{test,spec}.{ts,tsx,js,jsx}!",
        "!**/fixtures/**!",
      ],
    },
    "tools/*": {
      "entry": [],
      "project": [
        "**/*.{ts,tsx,js,jsx}!",
        "!**/tests/**!",
        "!**/*.{test,spec}.{ts,tsx,js,jsx}!",
        "!**/fixtures/**!",
      ],
    },
    "tools/smart-open": {
      // The receiver is launched by the macOS launchd agent.
      "entry": ["src/receive.ts!"],
      "project": [
        "**/*.{ts,tsx,js,jsx}!",
        "!**/tests/**!",
        "!**/*.{test,spec}.{ts,tsx,js,jsx}!",
        "!**/fixtures/**!",
      ],
    },
    "tools/agent-resource-run": {
      "entry": [],
      "project": [
        "**/*.{ts,tsx,js,jsx}!",
        "!**/tests/**!",
        "!**/*.{test,spec}.{ts,tsx,js,jsx}!",
        "!**/fixtures/**!",
        // Retained only by cgroup-memory.test.ts; the runner uses other readers.
        "!src/lib/cgroup-memory.ts!",
      ],
    },
    "tools/statusline": {
      "entry": [],
      "project": [
        "**/*.{ts,tsx,js,jsx}!",
        "!**/tests/**!",
        "!**/*.{test,spec}.{ts,tsx,js,jsx}!",
        "!**/fixtures/**!",
        // Fixture-only benchmark, not deployed production code.
        "!bench/render.ts!",
      ],
    },
    "tools/shared": {
      "entry": [],
      "project": [
        "**/*.{ts,tsx,js,jsx}!",
        "!**/tests/**!",
        "!**/*.{test,spec}.{ts,tsx,js,jsx}!",
        "!**/fixtures/**!",
        "!src/decode.ts!",
      ],
    },
  },
}
