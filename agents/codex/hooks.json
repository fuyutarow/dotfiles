{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh ~/.codex/herdr-agent-state.sh session",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "HOOK_SLUG=dotfiles:codex-task-continuity sh ~/.codex/hooks/run-continuity.sh",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "HOOK_SLUG=dotfiles:codex-herdr-metadata sh ~/.codex/hooks/run-herdr-metadata.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "HOOK_SLUG=dotfiles:codex-goal-kernel sh ~/.codex/hooks/run-goal-kernel.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "HOOK_SLUG=dotfiles:codex-goal-kernel sh ~/.codex/hooks/run-goal-kernel.sh",
            "timeout": 3
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "HOOK_SLUG=dotfiles:codex-goal-kernel sh ~/.codex/hooks/run-goal-kernel.sh --enforce",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "HOOK_SLUG=dotfiles:codex-goal-kernel sh ~/.codex/hooks/run-goal-kernel.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "HOOK_SLUG=dotfiles:codex-goal-kernel sh ~/.codex/hooks/run-goal-kernel.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "HOOK_SLUG=dotfiles:codex-task-continuity sh ~/.codex/hooks/run-continuity.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "HOOK_SLUG=dotfiles:ws-sole-creator sh ~/.claude/hooks/run.sh --fail-closed enforce-ws-sole-creator.ts"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "HOOK_SLUG=dotfiles:codex-dispatch-contract sh ~/.codex/hooks/run-dispatch-contract.sh"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "HOOK_SLUG=dotfiles:codex-goal-kernel sh ~/.codex/hooks/run-goal-kernel.sh --enforce",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "HOOK_SLUG=dotfiles:codex-goal-kernel sh ~/.codex/hooks/run-goal-kernel.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "HOOK_SLUG=dotfiles:codex-goal-kernel sh ~/.codex/hooks/run-goal-kernel.sh",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "HOOK_SLUG=dotfiles:codex-herdr-metadata sh ~/.codex/hooks/run-herdr-metadata.sh",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "HOOK_SLUG=dotfiles:reply-language sh ~/.codex/hooks/run-reply-language.sh"
          }
        ]
      }
    ]
  }
}
