[Unit]
Description=Notify the owner desktop once per recorded GPU stall
StartLimitIntervalSec=0

[Service]
Type=oneshot
WorkingDirectory=%h/dotfiles
Environment=PATH=%h/.bun/bin:%h/.local/bin:%h/.linuxbrew/bin:/home/linuxbrew/.linuxbrew/bin:/usr/bin:/bin
ExecStart=/usr/bin/env bun %h/dotfiles/tools/shared/src/gpu-stall-notify.ts
StandardOutput=journal
StandardError=journal
TimeoutStartSec=30s
