[Unit]
Description=Recover WSL host disk and memory headroom before compute exhausts the host

[Service]
Type=oneshot
WorkingDirectory=%h/dotfiles
# kondo, bun and mise live in Linuxbrew, and cargo (for the cargo-clean stage) in its keg-only
# rustup bin; none is on systemd's base PATH.
Environment=PATH=/home/linuxbrew/.linuxbrew/bin:/home/linuxbrew/.linuxbrew/opt/rustup/bin:/usr/bin:/bin
# Reclaim tmpfs when either bytes or inodes reach 80% use.
Environment=TMPFS_RECLAIM_PERCENT=80
# The shim is deliberately used by this non-interactive service in the repo that declares bun.
ExecStart=%h/.local/share/mise/shims/bun %h/dotfiles/scripts/wsl-capacity-recover.ts
# HOLD is an expected capacity verdict; only FATAL (2) means the controller itself failed.
SuccessExitStatus=1
TimeoutStartSec=15min
CPUQuota=100%
MemoryHigh=256M
MemoryMax=512M
MemorySwapMax=0
TasksMax=256
