{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "HOOK_SLUG=dotfiles:graveyard-scope sh ~/.agents/hooks/run.sh --fail-closed enforce-graveyard-scope"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "HOOK_SLUG=dotfiles:repo-bash-deny sh ~/.agents/hooks/run.sh --fail-closed enforce-repo-bash-deny"
          }
        ]
      }
    ]
  }
}
