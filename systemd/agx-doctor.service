[Unit]
Description=Refresh agx diagnostics through the public bounded refresh contract
StartLimitIntervalSec=0

[Service]
Type=oneshot
WorkingDirectory=%h/dotfiles
Environment=PATH=%h/.bun/bin:%h/.local/bin:%h/.linuxbrew/bin:/home/linuxbrew/.linuxbrew/bin:/usr/bin:/bin
# The timer bounds frequency; agx owns admission and cross-process coalescing.
ExecStart=/usr/bin/env mise -C %h/dotfiles exec -- agx doctor --json --refresh
SuccessExitStatus=1
# Budget: 125s whole-request deadline + 55s startup/publication margin.
TimeoutStartSec=180s
StandardOutput=journal
StandardError=journal
