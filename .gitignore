# Owner: repository maintainers. These are repo-local agent state and tool-owned data.
/.serena/
/.agent-state/

# Owner: AGX coordinators. The whole directory is coordinator working state; promote durable conclusions to owned docs.
/.agents/

# Owner: agent command framework. System command assets are tool-managed.
/agents/commands/.system/

# Owner: ccc. Its local data is tool-owned; only the declared settings survive.
/.cocoindex_code/*
!/.cocoindex_code/settings.yml

# Owner: Finder. Directory metadata is machine-local at any depth.
**/.DS_Store

# Owner: ccc MCP. Root-level runtime logs are local diagnostic output.
/ccc_mcp_*.log

# Owner: the human using this checkout. Only root-level local overrides and backup trees.
/local/
/backups/

# Owner: each tool that creates its own machine-local permission override.
**/settings.local.json

# Owner: each toolchain. Canonical regenerable-path list consumed by disk-reclaim.
# `**/` scopes these generated directory names at any depth; disk-reclaim normalizes the
# prefix back to the matching path/basename.
# BEGIN regenerable-ignored
**/target/
**/node_modules/
**/.venv/
**/build/
**/dist/
**/__pycache__/
**/.rumdl_cache/
**/.ruff_cache/
**/.pytest_cache/
**/.mypy_cache/
**/.julia/compiled/
# END regenerable-ignored

# Owner: the relevant build/runtime tool; receipts and bytecode are generated beside inputs.
**/*.resource.json.peak.json

# Owner: the human. Convenience only for common root-level local environment files; secret
# prevention belongs in the pre-commit scan, not in ignore rules.
/.env
/.env.local

