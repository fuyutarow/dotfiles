# Gate startup debug logs behind $DOTFILES_DEBUG (export DOTFILES_DEBUG=1 to see them)
_dbg(){ [[ -n "$DOTFILES_DEBUG" ]] && echo "[DEBUG] $*"; }

_dbg "Starting .zprofile"

# Homebrew
_dbg "Setting up Homebrew"
if [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
else
  _dbg "Homebrew not found at /home/linuxbrew/.linuxbrew/bin/brew"
fi

# PATH exports
_dbg "Setting up PATH exports"
# bun global package bins (claude, gemini, …); bun itself now comes from Homebrew, not ~/.bun
[ -d "$HOME/.bun/bin" ] && export PATH="$HOME/.bun/bin:$PATH"
# Keep ~/.local/bin after Bun insertion so official standalone CLIs (e.g. Codex)
# beat stale npm/Bun shims in login shells too. Non-login SSH gets this from .zshenv.
export PATH="$HOME/.local/bin:$PATH"

# CUDA — guarded like every other PATH addition here. Unguarded, it pinned a version-specific
# absolute path onto PATH/LD_LIBRARY_PATH even on machines without it (measured: this box has no
# /usr/local/cuda-12.4, so it was a dead entry on every shell).
if [ -d /usr/local/cuda-12.4 ]; then
  export CUDA_HOME=/usr/local/cuda-12.4
  export PATH="$CUDA_HOME/bin:$PATH"
  export LD_LIBRARY_PATH="$CUDA_HOME/lib64:${LD_LIBRARY_PATH:-}"
fi

# # Conda
# export PATH="$HOME/miniconda3/bin:$PATH"
# source $HOME/miniconda3/etc/profile.d/conda.sh

export PATH="$HOME/.cargo/bin:$PATH"

# --- Windows interop PATH -----------------------------------------------------
# Under systemd=true, WSL boots systemd as PID 1 in a clean namespace and does NOT
# inherit the Windows PATH that /init injects, so appendWindowsPath is effectively
# ignored. Re-expose only what we use, and keep the huge /mnt/c/Windows/System32
# OFF $PATH so TAB-completion stays fast over the 9p bridge.
# WindowsApps holds the App Execution Aliases (winget.exe & co) — small dir, cheap.
# (winget.exe is a 0-byte alias stub: it must live on PATH; it can NOT be symlinked.)
for _wa in /mnt/c/Users/*/AppData/Local/Microsoft/WindowsApps(N); do
  # Skip empty template profiles (Default / Default User) by requiring the winget
  # alias as a sentinel; dedupe so repeated sourcing doesn't stack entries.
  [[ -e "$_wa/winget.exe" && ":$PATH:" != *":$_wa:"* ]] && export PATH="$PATH:$_wa"
done
unset _wa
# Real Windows PE tools used from WSL: symlink the actual binaries into ~/.local/bin
# (already on PATH) instead of putting their huge parent dirs on $PATH.
# DOCTRINE — curated allowlist, NOT full interop:
#  * Windows-ONLY tools earn a symlink here (explorer, powershell, agy, ...).
#  * Cross-platform tools (uv/uvx, codex, claude, rg, ...) use the LINUX install — never
#    link their .exe twins even though winget ships them; the Linux binary must win.
#  * Why symlinks and not PATH: ~/.local/bin is already on the PATH of every long-lived
#    env snapshot (herdr server included, which freezes its env at start and has no way
#    to refresh it). A new symlink changes directory CONTENT, not PATH — so it becomes
#    visible in ALL live panes instantly, no reload/restart/new-tab needed.
# DELIBERATELY NO bare-name `cmd.exe` shim here: Zed's remote-SSH OS probe runs
# `cmd.exe /c ver`, and via WSL interop that execs the REAL Windows cmd.exe printing
# "Microsoft Windows [...]", so Zed misdetects this Linux box as Windows and aborts with
# "windows-%PROCESSOR_ARCHITECTURE%". `start` (zsh/wsl.zsh) calls cmd by absolute path instead.
typeset -gA _WIN_EXES=(
  explorer.exe   '/mnt/c/Windows/explorer.exe'
  powershell.exe '/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe'
  agy.exe        '/mnt/c/Users/*/AppData/Local/Microsoft/WinGet/Packages/Google.AntigravityCLI_*/agy.exe'
  # Bare name too: `alias agy=agy.exe` only fires in an interactive zsh, but scripts resolve
  # via PATH — agents/skills/driving-antigravity/scripts/probe-models.sh gates on `command -v agy`.
  agy            '/mnt/c/Users/*/AppData/Local/Microsoft/WinGet/Packages/Google.AntigravityCLI_*/agy.exe'
  # `code` is NOT an .exe: it is the sh launcher VS Code ships FOR WSL (opens Windows
  # VS Code attached to this distro). It self-locates via `realpath "$0"`, so a symlink
  # is safe. Do NOT link Code.exe directly — it would open a blank Windows-side window.
  code           '/mnt/c/Users/*/AppData/Local/Programs/Microsoft VS Code/bin/code'
  # Antigravity IDE (the GUI, a VS Code fork) ships the same sh launcher; the CLI is `agy`.
  antigravity-ide '/mnt/c/Users/*/AppData/Local/Programs/Antigravity IDE/bin/antigravity-ide'
)
link-win-exes() {
  local name pat
  local -a hits
  mkdir -p "$HOME/.local/bin"
  for name pat in "${(@kv)_WIN_EXES}"; do
    # -e follows symlinks: a healthy link = single stat. A DANGLING link fails -e and gets
    # relinked here (that self-heal is why a Windows-side reinstall/upgrade can't rot a shim).
    [[ -e "$HOME/.local/bin/$name" ]] && continue
    hits=( ${~pat}(N) )
    (( $#hits )) && ln -sf "$hits[1]" "$HOME/.local/bin/$name"
  done
  # Sweep shims this allowlist no longer owns AND that no longer resolve — e.g. `agy` when
  # Antigravity moved from a direct install to a winget package dir. A dangling shim is worse
  # than a missing one: `command -v` fails while the name still looks present to a human.
  for name in "$HOME"/.local/bin/*(N@); do
    [[ -e "$name" ]] && continue                       # resolves → keep
    [[ -n "${_WIN_EXES[${name:t}]:-}" ]] && continue   # allowlisted → relinked above
    command rm -f -- "$name"
  done
}
link-win-exes
# sshd/herdr-born sessions lack the WSL identity vars that Windows-launched sessions get
# (WSL_DISTRO_NAME & co). VS Code's bin/code probes $WSL_DISTRO_NAME, then falls back to a
# WSL1-era `uname -r` regex ("...-Microsoft") that today's "-microsoft-standard-WSL2" kernels
# never match — so it misdetects non-WSL and launches Code.exe ATTACHED to the terminal
# (prompt blocks until the window closes). Derive the name; never hardcode it.
if [[ -z "$WSL_DISTRO_NAME" ]] && command -v wslpath >/dev/null 2>&1; then
  _wsl_root="$(wslpath -w / 2>/dev/null)"; _wsl_root="${_wsl_root%\\}"
  [[ "$_wsl_root" == '\\'* ]] && export WSL_DISTRO_NAME="${_wsl_root##*\\}"
  unset _wsl_root
fi
# Migration: purge any legacy bare-name cmd.exe shim an older rev created (breaks Zed WSL2 detect).
[[ -e "$HOME/.local/bin/cmd.exe" || -e "$HOME/.local/bin/cmd.exe.zed-disabled" ]] &&
  command rm -f "$HOME/.local/bin/cmd.exe" "$HOME/.local/bin/cmd.exe.zed-disabled"
# -----------------------------------------------------------------------------


# Source commands
_dbg "Sourcing cargo env"
if [[ -f "$HOME/.cargo/env" ]]; then
  source "$HOME/.cargo/env"
else
  _dbg "Warning: $HOME/.cargo/env not found"
fi

_dbg "Setting up fnm"
# NOTE (both eval blocks below): the old form piped into the FIXED names /tmp/fnm_env and
# /tmp/sheldon_source, then sourced them as shell code. /tmp is world-writable and sticky, so on
# any shared host another user could pre-create those paths (or a symlink through them) and get
# their code sourced into this login shell; concurrent shells also raced on the same file. Eval
# the output directly — no file, no race, no plant surface. The 5s timeout survives (a wedged
# `fnm`/`sheldon` must not hang the shell); with $() the timeout's exit status is what we test.
if command -v fnm &> /dev/null; then
  _fnm_env="$(timeout 5s fnm env 2>/dev/null)" && eval "$_fnm_env" ||
    _dbg "Warning: fnm env timed out or failed"
  unset _fnm_env
else
  _dbg "Warning: fnm not found"
fi


# X11 configuration
_dbg "Setting up X11"
if [[ -f /etc/resolv.conf ]]; then
  export DISPLAY=$(cat /etc/resolv.conf | grep nameserver | awk '{print $2}'):0
fi

# Sheldon (load this last)
_dbg "Setting up sheldon"
if command -v sheldon &> /dev/null; then
  # Eval directly — see the /tmp note above the fnm block.
  if _sheldon_src="$(timeout 5s sheldon source 2>/dev/null)"; then
    eval "$_sheldon_src"
  else
    _dbg "Warning: sheldon source timed out or failed"
    # Fallback: load aliases directly
    _dbg "Loading aliases.zsh directly as fallback"
    if [[ -f "$HOME/dotfiles/zsh/aliases.zsh" ]]; then
      source "$HOME/dotfiles/zsh/aliases.zsh"
    fi
  fi
  unset _sheldon_src
else
  _dbg "Warning: sheldon not found"
  # Fallback: load aliases directly
  _dbg "Loading aliases.zsh directly as fallback"
  if [[ -f "$HOME/dotfiles/zsh/aliases.zsh" ]]; then
    source "$HOME/dotfiles/zsh/aliases.zsh"
  fi
fi

_dbg "Setting up direnv"
if command -v direnv &> /dev/null; then
  eval "$(direnv hook zsh)"
else
  _dbg "Warning: direnv not found"
fi



# bun completions
_dbg "Setting up bun completions"
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# Sui version path configuration
_dbg "Setting up Sui"
if [[ -f "$HOME/.suim/current" ]]; then
  export SUI_VERSION_PATH="$HOME/.suim/versions/$(cat $HOME/.suim/current)"
  export PATH="$SUI_VERSION_PATH:$PATH"
else
  _dbg "Warning: $HOME/.suim/current not found"
fi


# for Rust
export RUSTC_WRAPPER="sccache"

_dbg "Finished .zprofile"
