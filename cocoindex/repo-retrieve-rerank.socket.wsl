# Socket for the `repo-retrieve definition` reranker (agents/retrieval-control/rerank_server.py).
# Symlinked to ~/.config/systemd/user/ by scripts/link-dots.sh; enabled by `mise run wsl:rerank`.
# Socket activation: systemd listens here at all times and starts the service on the first
# request; the service exits after 30 idle minutes (VRAM back to the host), and the next request
# starts it again. A caller never manages the process.
[Unit]
Description=repo-retrieve reranker socket

[Socket]
ListenStream=%h/.cache/repo-retrieve/rerank.sock
SocketMode=0600
DirectoryMode=0700
Accept=no

[Install]
WantedBy=sockets.target
