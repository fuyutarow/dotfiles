{
  "extends": "./standard-presets/typescript/tsconfig.json",
  "compilerOptions": {
    "noPropertyAccessFromIndexSignature": true,
    "paths": {
      "@dotfiles/shared/*": ["./tools/shared/*"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": [
    "node_modules",
    // Intentionally invalid fixtures are compiled in their own preset test process.
    "standard-presets/tests/fixtures",
    // Retired code: nothing links or runs archives/ (see archives/skills/README.md), so it is
    // outside the audit, like node_modules.
    "archives",
    // A symlink to tools/repo-retrieve/src/repo-retrieve.ts. TypeScript checks it at the LINK path and
    // resolves its relative imports (./ccc-index.ts, ./child.ts, ../../shared/src/zod.ts) from agents/claude/hooks/,
    // where they do not exist — two false errors. The real file is checked at its own path.
    "agents/claude/hooks/repo-retrieve.ts"
  ]
}
