# Common aliases for all platforms

# Modern CLI tool replacements
type "eza" >/dev/null 2>&1 && alias ls='eza' || alias ls='ls --color=auto'
type "bat" >/dev/null 2>&1 && alias cat='bat' || alias cat='cat'
type "rg" >/dev/null 2>&1 && alias grep='rg' || alias grep='grep --color=auto'
type "fd" >/dev/null 2>&1 && alias find='fd' || alias find='find'
type "delta" >/dev/null 2>&1 && alias diff='delta' || alias diff='diff --color=auto'
type "dust" >/dev/null 2>&1 && alias du='dust' || alias du='du -h'
type "procs" >/dev/null 2>&1 && alias ps='procs' || alias ps='ps'
type "rip" >/dev/null 2>&1 && alias rm='rip' || alias rm='rm -i'

# Directory navigation
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias l='ls -F'
alias la='ls -A'
alias ll='ls -alF'
alias lt='ls -FT'

# Git
alias g='git'
alias gs='git status'
alias ga='git add'
alias gc='git commit'
alias gp='git push'
alias gl='git log'
alias gd='git diff'

# Docker
alias d='docker'
alias dc='docker-compose'

# Quick edits
alias e='${EDITOR:-vim}'
alias v='vim'

# Shortcuts
alias h='history 100'
alias j='just'
alias jl='just -l'
alias tf='tail -f'

# Tmux
alias t='tmux'
alias ta='tmux attach'
alias tl='tmux ls'
alias tn='tmux new -s'

# Package managers
alias b='bun'
alias bb='bun run build'
alias bn='bun run'

# Source configs
alias sz='source ~/.zshrc'
alias sa='source ~/.aliases'