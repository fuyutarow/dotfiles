{
  "$schema": "https://unpkg.com/knip@6.42.1/schema-jsonc.json",
  "ignoreExportsUsedInFile": true,
  "ignore": ["archives/**"],
  "workspaces": {
    ".": {
      "entry": [],
      "project": [
        "**/*.{ts,tsx,js,jsx}!",
        "!**/tests/**!",
        "!**/*.{test,spec}.{ts,tsx,js,jsx}!",
        "!**/fixtures/**!",
      ],
      "ignoreDependencies": [
        "knip",
        "oxlint",
        "oxlint-plugin-eslint",
        "oxlint-tsgolint",
        "oxfmt",
      ],
      "ignoreBinaries": ["mise"],
    },
    "tools/*": {
      "entry": [],
      "project": [
        "**/*.{ts,tsx,js,jsx}!",
        "!**/tests/**!",
        "!**/*.{test,spec}.{ts,tsx,js,jsx}!",
        "!**/fixtures/**!",
      ],
    },
  },
}
