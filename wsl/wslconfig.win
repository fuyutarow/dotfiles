# WSL2 host-side config for r99 (compute server).
# ASCII/UTF-8 ONLY. This file was previously saved as CP932 with Japanese comments and the
# bytes were already corrupted on disk; rewritten 2026-09-06, revised 2026-09-09.
[wsl2]

# Host has 63.9 GB physical. 60 GB left Windows ~3.9 GB, which is over-committed; 56 GB is the
# value this file itself pre-designated as the fallback.
# CORRECTION 2026-09-11: an earlier version of this comment blamed memory pressure for the NVIDIA
# LocalSystem Container crashing on 2026-09-06. That was a misdiagnosis. The service was crash-
# looping every ~8 s from 2026-09-08 20:24 for three days (~29,000 times) because a 2025-05-07
# NVIDIA App update left a 0-byte plugin DLL beside its _-prefixed predecessor, and the container
# exited with code 14109 on every start. It was independent of memory and of C:. That storm is
# what eventually crashed WSLg's weston (rdp-backend.so segfault) and took the VM down on
# 2026-09-11. Root-caused and removed: GeForce Experience and all its containers are uninstalled;
# the display driver (591.86) and CUDA 12.4-13.2 are untouched. This box does CUDA, not games.
#
# READ THIS BEFORE EXPECTING IT TO FREE MEMORY: memory= is a CAP, not a reservation - WSL grows
# on demand and this only bounds the worst case. Measured 2026-09-09 with the cap still at 60 GB:
# vmmemWSL held 44.96 GB while the guest reported 27 GB used / 24 GB buff+cache / 31 GB
# available, with memory PSI flat at 0.00. The guest was never short of memory and never reached
# the cap, so lowering 60 -> 56 frees nothing by itself. What actually holds host RAM is the
# guest's page cache; reclaim it live, with no restart, from inside the distro:
#   sync; echo 3 > /proc/sys/vm/drop_caches
memory=56GB

# 12 of the host's 16 logical processors, leaving 4 for Windows. Guest loadavg was 19.28 on these
# 12 (1.6x oversubscribed) on 2026-09-09 under a 4-process julia workload, with cpu PSI some
# avg10=18.5%. That is the workload's shape, not a misconfiguration - do not raise this to 16
# without leaving Windows something, since the host CPU already reads 100%.
processors=12

# Backed by %TEMP%\<guid>\swap.vhdx, which is materialised on distro start and counts against C:.
# Measured 2026-09-08: 16 GB on disk while only 350 MB was in use. It cannot be relocated off C:
# with swapFile= here, because the only other volume (E:) is exFAT and cannot host a sparse vhdx.
# C: fell from 53.7 GB free to 0.36 GB on 2026-11-01 and recovered after termination; swap
# could have contributed, but its allocated-byte change was not measured. Keep the cap until
# workload and host measurements justify reducing it; do not infer the cause from this alone.
swap=16GB

# Bridges Windows 127.0.0.1:<port> to a WSL listener. Keeps the ProxyJump fallback route into
# WSL sshd (port 2222) available when the in-WSL tailnet node is down, and serves dev servers.
localhostForwarding=true

nestedVirtualization=true

# Default is 10 retained crash dumps under %TEMP%\wsl-crashes. Measured 2026-09-09: that
# directory regrew 1.37 GB in ONE day after being emptied - this distro crashes often enough that
# the default retention is a standing disk cost on a drive that has hit zero free twice this
# week. Two is enough to compare a repeat crash against its predecessor.
maxCrashDumpCount=2

# debugConsoleLogFile is unset: WSL documents append, but no rotation or size limit. Kernel
# output would help diagnose the 2026-11-01 and 2026-11-04 stops, but an unbounded log on C:
# risks another full disk. Enable only with a tested host-side size bound and cleanup; a suitable
# destination is C:\\Users\\fuyutarow\\AppData\\Local\\wsl-kernel.log (outside Temp).

# Ceiling for the file system of any distro created FROM NOW ON (600 GiB in bytes; this key takes
# a byte count and is spelled out rather than "600GB" so a suffix-parsing difference can never
# make the whole file malformed - a malformed .wslconfig is silently IGNORED IN FULL by WSL).
#
# It does NOT resize the existing Ubuntu-24.04, whose vhdx max is still the 1 TB default. That
# 1 TB ceiling is larger than C: itself (930 GB), which is precisely how WSL was able to fill the
# system drive on 2026-09-06. Capping the existing distro needs the distro Stopped:
#   wsl --manage Ubuntu-24.04 --resize <size>
# 2026-10-15: raised 400 -> 600 GiB on owner request; 400 GiB capped r99-u26 at 393 GiB with
# ~300 GiB still free on C:. 600 GiB keeps the ceiling below C: (930 GB).
defaultVhdSize=644245094400

# WSLg is ON again (2026-11-09), deliberately and on owner request: Claude Code in this distro
# pastes clipboard images through X11 (Alt+V) and fails with "X11 server connection timed out"
# when WSLg is off (DISPLAY is empty, /mnt/wslg has no X socket).
# History: it was OFF from 2026-09-11. weston - WSLg's compositor - crashed ten times in sixteen
# minutes (09:46:48 to 10:02:24, every ~100 s) and took the whole VM down at 10:03, while nothing
# had ever asked WSLg for a window. The crash-dump cap above does not contain a crash LOOP. The
# root cause was the NVIDIA container storm described at the top of this file, since removed.
# If weston crash-loops again, set this back to false FIRST and investigate after.
# WSL 3.0.5 fixes global guiApplications=false suppression of a distro GUI opt-in:
# https://github.com/microsoft/WSL/pull/41973
guiApplications=true

[general]

# Disable the distro idle shutdown timer; vmIdleTimeout governs the VM after distros stop.
# WSL 2.9.8 stopped the distro despite vmIdleTimeout=-1, interrupting reachability. Keep the
# existing Windows keepalive task until this setting has been tested on r99 after deployment.
# https://learn.microsoft.com/en-us/windows/wsl/wsl-config#general-wsl-settings
instanceIdleTimeout=-1

[experimental]

# Newly created VHDs stay non-sparse: offline compaction refuses sparse VHDs, and enabling sparse
# on existing VHDs requires --allow-unsafe because of corruption reports. This does not change
# the sparse attribute of an existing VHD.
sparseVhd=false

# autoMemoryReclaim is DELIBERATELY UNSET (default dropCache). WSL 2.9 changed idle reclaim:
# after two minutes idle, dropCache runs once; gradual continues reclaiming cold cache toward a
# floor and can retain less memory. Keep the default until r99 workload measurements justify a
# change; the 56 GB cap alone does not reclaim cache during sustained work.
# https://github.com/microsoft/WSL/pull/41096
