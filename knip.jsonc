{
  "$schema": "https://unpkg.com/knip@6.42.1/schema-jsonc.json",
  "ignoreExportsUsedInFile": true,
  // jj's internal run working copies (.jj/run/**) hold tracked-looking copies, not repo content.
  "ignore": ["archives/**", ".obsidian/**", ".jj/**"],
  "workspaces": {
    ".": {
      // The mise plugin labels task scripts as development entries, which otherwise
      // filters even explicitly declared production roots out of the graph.
      "mise": false,
      "entry": [],
      "project": [
        "**/*.{ts,tsx,js,jsx}!",
        "!**/tests/**!",
        "!**/*.{test,spec}.{ts,tsx,js,jsx}!",
        "!**/fixtures/**!",
        "!herdr-pane.ts!",
        "!**/herdr-pane.ts!",
      ],
      "ignoreDependencies": [
        "knip",
        "oxlint",
        "oxlint-plugin-eslint",
        "oxlint-tsgolint",
        "oxfmt",
      ],
      "ignoreBinaries": ["mise", "coredev"],
    },
    "agents/codex": {
      "entry": [],
      "project": [
        "**/*.{ts,tsx,js,jsx}!",
        "!**/tests/**!",
        "!**/*.{test,spec}.{ts,tsx,js,jsx}!",
        "!**/fixtures/**!",
        // Read only by tests (the Herdr pane-name probe); the hooks resolve the pane another way.
        "!**/herdr-pane.ts!",
      ],
    },
    "standard-presets": {
      // oxlint loads these through the root .oxlintrc.json `jsPlugins`, not an import.
      "entry": ["typescript/*-plugin.js!"],
      "project": [
        "**/*.{ts,tsx,js,jsx}!",
        "!**/tests/**!",
        "!**/*.{test,spec}.{ts,tsx,js,jsx}!",
        "!**/fixtures/**!",
      ],
    },
    "config/obsidian": {
      // Shell and remote launchers invoke these scripts; Obsidian loads the plugin.
      "entry": [
        "open-vault.ts!",
        "open-remote.ts!",
        "forget-shadow.ts!",
        "local-plugins/doc-view/main.js!",
      ],
      "project": [
        "**/*.{ts,tsx,js,jsx}!",
        "!**/*.{test,spec}.{ts,tsx,js,jsx}!",
      ],
    },
    "tools/disk-reclaim": {
      "entry": [],
      "project": [
        "**/*.{ts,tsx,js,jsx}!",
        "!**/tests/**!",
        "!**/*.{test,spec}.{ts,tsx,js,jsx}!",
        "!**/fixtures/**!",
      ],
    },
    "tools/*": {
      "entry": [],
      "project": [
        "**/*.{ts,tsx,js,jsx}!",
        "!**/tests/**!",
        "!**/*.{test,spec}.{ts,tsx,js,jsx}!",
        "!**/fixtures/**!",
      ],
    },
    "tools/smart-copy": {
      // The declared probe (tool.toml `probes`) is launched by scripts/tool-probe.ts from the path
      // the declaration names, which no import statement shows.
      "entry": ["src/doctor-clipboard.ts!"],
      "project": [
        "**/*.{ts,tsx,js,jsx}!",
        "!**/tests/**!",
        "!**/*.{test,spec}.{ts,tsx,js,jsx}!",
        "!**/fixtures/**!",
      ],
    },
    "tools/smart-open": {
      // The receiver is launched by the macOS launchd agent.
      "entry": ["src/receive.ts!"],
      "project": [
        "**/*.{ts,tsx,js,jsx}!",
        "!**/tests/**!",
        "!**/*.{test,spec}.{ts,tsx,js,jsx}!",
        "!**/fixtures/**!",
      ],
    },
    "tools/agent-resource-run": {
      "entry": [],
      "project": [
        "**/*.{ts,tsx,js,jsx}!",
        "!**/tests/**!",
        "!**/*.{test,spec}.{ts,tsx,js,jsx}!",
        "!**/fixtures/**!",
        // Retained only by cgroup-memory.test.ts; the runner uses other readers.
        "!src/lib/cgroup-memory.ts!",
      ],
    },
    "tools/statusline": {
      "entry": [],
      "project": [
        "**/*.{ts,tsx,js,jsx}!",
        "!**/tests/**!",
        "!**/*.{test,spec}.{ts,tsx,js,jsx}!",
        "!**/fixtures/**!",
        // Fixture-only benchmark, not deployed production code.
        "!bench/render.ts!",
      ],
    },
    "tools/shared": {
      "entry": [],
      "project": [
        "**/*.{ts,tsx,js,jsx}!",
        "!**/tests/**!",
        "!**/*.{test,spec}.{ts,tsx,js,jsx}!",
        "!**/fixtures/**!",
        "!src/decode.ts!",
      ],
    },
  },
}
