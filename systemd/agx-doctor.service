[Unit]
Description=Refresh agx diagnostic state after owner inputs change
StartLimitIntervalSec=0

[Service]
Type=oneshot
WorkingDirectory=%h/dotfiles
Environment=PATH=%h/.bun/bin:%h/.local/bin:%h/.linuxbrew/bin:/home/linuxbrew/.linuxbrew/bin:/usr/bin:/bin
# Every activation waits 60s, including after failures. The singleton coalesces
# input changes during this window and the run; doctor starts at most once/60s.
# Keep StartLimitIntervalSec=0: a rate-limit rejection would disable the path.
ExecStartPre=/usr/bin/sleep 60
ExecStart=/usr/bin/env bun %h/dotfiles/scripts/agx-doctor.ts --json
SuccessExitStatus=1
TimeoutStartSec=120s
StandardOutput=journal
StandardError=journal
