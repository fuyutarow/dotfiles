// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`snapshot renders one fleet row in order from the actual agx fold; fresh, stale and missing never invoke jj: fresh 1`] = `"+2 workers in other sessions"`;

exports[`snapshot renders one fleet row in order from the actual agx fold; fresh, stale and missing never invoke jj: old 1`] = `"+2 workers in other sessions"`;

exports[`snapshot renders one fleet row in order from the actual agx fold; fresh, stale and missing never invoke jj: missing 1`] = `""`;

exports[`worker phrase snapshot: here 2, others 2 1`] = `"+2 workers in other sessions"`;

exports[`worker phrase snapshot: here 2, others 0 1`] = `""`;

exports[`worker phrase snapshot: here 0, others 3 1`] = `"+3 workers in other sessions"`;
