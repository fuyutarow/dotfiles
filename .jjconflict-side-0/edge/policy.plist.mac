<?xml version="1.0" encoding="UTF-8"?>
<!-- Microsoft Edge managed policy — deployed to /Library/Managed Preferences/com.microsoft.Edge.plist
     by `mise run edge:policy` (a COPY with sudo: Edge treats only root-owned managed preferences as
     policy, so a symlink or ~/Library/Preferences entry would be ignored). `mise run doctor` (check
     `edge-policy`) fails when the live file differs. Verify in Edge at edge://policy.

     Why it exists: the "You.com" extension (ffoiecgjambohnpffggcdidbomhmcack, installed outside the
     Edge Add-ons store 2026-04-13) declares chrome_settings_overrides.search_provider.is_default and
     so took over the default search engine. The blocklist removes the cause; the DefaultSearchProvider
     keys pin the result so no extension can take it again. Side effect: Edge shows "managed by your
     organization", and the search engine can no longer be changed in the UI — edit it here. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>ExtensionInstallBlocklist</key>
  <array>
    <string>ffoiecgjambohnpffggcdidbomhmcack</string>
  </array>
  <key>DefaultSearchProviderEnabled</key>
  <true/>
  <key>DefaultSearchProviderName</key>
  <string>Google</string>
  <key>DefaultSearchProviderKeyword</key>
  <string>google.com</string>
  <key>DefaultSearchProviderSearchURL</key>
  <string>https://www.google.com/search?q={searchTerms}</string>
  <key>DefaultSearchProviderSuggestURL</key>
  <string>https://www.google.com/complete/search?output=chrome&amp;q={searchTerms}</string>
  <!-- New-tab page search box: "redirect" sends it to the address bar's engine instead of Bing. -->
  <key>NewTabPageSearchBox</key>
  <string>redirect</string>
</dict>
</plist>
