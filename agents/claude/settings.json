{
  "permissions": {
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Task|Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "HOOK_SLUG=dotfiles:dispatch-contract sh ~/.claude/hooks/run.sh --fail-closed enforce-dispatch-contract.ts"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "HOOK_SLUG=dotfiles:supervised-execution sh ~/.claude/hooks/run.sh --fail-closed enforce-supervised-execution.ts"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "HOOK_SLUG=dotfiles:official-execution sh ~/.claude/hooks/run.sh --fail-closed enforce-official-execution.ts"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "HOOK_SLUG=dotfiles:no-new-bash sh ~/.claude/hooks/run.sh --fail-closed enforce-no-new-bash.ts"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "HOOK_SLUG=dotfiles:claude-goal-kernel sh ~/.claude/hooks/run-goal-kernel.sh --enforce",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "HOOK_SLUG=dotfiles:background-waits sh ~/.claude/hooks/run.sh --fail-closed enforce-background-waits.ts"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh ~/.claude/hooks/herdr-agent-state.sh session",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "HOOK_SLUG=dotfiles:claude-task-continuity sh ~/.claude/hooks/run.sh task-continuity.ts",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "HOOK_SLUG=dotfiles:herdr-tab-name sh ~/.claude/hooks/run.sh herdr-tab-name.ts",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "HOOK_SLUG=dotfiles:claude-goal-kernel sh ~/.claude/hooks/run-goal-kernel.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "HOOK_SLUG=dotfiles:claude-goal-kernel sh ~/.claude/hooks/run-goal-kernel.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "HOOK_SLUG=dotfiles:claude-goal-kernel sh ~/.claude/hooks/run-goal-kernel.sh --enforce",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "HOOK_SLUG=dotfiles:assign-command sh ~/.claude/hooks/run.sh assign-command.ts",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "quote",
        "hooks": [
          {
            "type": "command",
            "command": "HOOK_SLUG=dotfiles:quote-command sh ~/.claude/hooks/run.sh quote-command.ts",
            "timeout": 20
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "HOOK_SLUG=dotfiles:claude-goal-kernel sh ~/.claude/hooks/run-goal-kernel.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "HOOK_SLUG=dotfiles:claude-goal-kernel sh ~/.claude/hooks/run-goal-kernel.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "HOOK_SLUG=dotfiles:claude-task-continuity sh ~/.claude/hooks/run.sh task-continuity.ts",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "HOOK_SLUG=dotfiles:claude-goal-kernel sh ~/.claude/hooks/run-goal-kernel.sh",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "HOOK_SLUG=dotfiles:leaked-toolcall sh ~/.claude/hooks/run.sh detect-leaked-toolcall.ts"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "HOOK_SLUG=dotfiles:audit-theater sh ~/.claude/hooks/run.sh detect-audit-theater.ts"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "HOOK_SLUG=dotfiles:groundless-claim sh ~/.claude/hooks/run.sh detect-groundless-claim.ts"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "HOOK_SLUG=dotfiles:reply-language sh ~/.claude/hooks/run.sh enforce-reply-language.ts"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "HOOK_SLUG=dotfiles:capture-last-response sh ~/.claude/hooks/run.sh capture-last-response.ts"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "HOOK_SLUG=dotfiles:sys-snapshot sh ~/.claude/hooks/run.sh log-sys-snapshot.ts",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "HOOK_SLUG=dotfiles:claude-goal-kernel sh ~/.claude/hooks/run-goal-kernel.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "HOOK_SLUG=dotfiles:sys-snapshot sh ~/.claude/hooks/run.sh log-sys-snapshot.ts",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "HOOK_SLUG=dotfiles:existing-definition sh ~/.claude/hooks/run.sh suggest-existing-definition.ts",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "HOOK_SLUG=dotfiles:bash-duration sh ~/.claude/hooks/run.sh record-bash-duration.ts"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "HOOK_SLUG=dotfiles:claude-goal-kernel sh ~/.claude/hooks/run-goal-kernel.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enableWorkflows": false,
  "statusLine": {
    "type": "command",
    "command": "~/.bun/bin/statusline",
    "refreshInterval": 5
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": false,
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "effortLevel": "medium",
  "ultracode": false,
  "tui": "fullscreen",
  "theme": "dark",
  "switchModelsOnFlag": true,
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "language": "japanese"
}
