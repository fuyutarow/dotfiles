#!/bin/sh
# shim: hook-entry
# What the commit gate runs is declared in mise.toml's `hook:pre-commit` (depends-only over the
# contract verbs) — one place to read and change it. `--jobs 1`: mise 2026.9.12's parallel
# scheduler hangs on a failing dependency and ignores SIGTERM (measured 3/6); serial never did.
command -v mise > /dev/null 2>&1 || {
  echo "pre-commit: mise not on PATH; gate skipped (run 'mise run hook:pre-commit' manually)" >&2
  exit 0
}
exec mise run --jobs 1 hook:pre-commit
