{
  // Type-check contract for this repo's own TS (mise: typecheck). Bun TRANSPILES and never
  // type-checks (writing-bun-scripts LAW), so until 2026-09-12 nothing in this repo had ever
  // been type-checked; `tsgo --noEmit` is the only place these flags bite. Flags mirror
  // Coral-dpp's tsconfig minus Next/React/DOM. The two flags that carry most of the backlog
  // are `noUncheckedIndexedAccess` (arr[i] is T | undefined) and `exactOptionalPropertyTypes`
  // (`{a?: T}` refuses an explicit undefined) — measured 2026-09-12: 203 errors at this
  // setting, 90 with those two off. Both stay ON; the 203 were paid down the same day (real
  // findings among them: a bogus type predicate on learning-bus.ts's timestamp(), a cleye
  // multi-value flag tuple in ccc-swap.ts, an acquireLease() return type wider than its
  // returns). agents/skills/** is checked like the rest: it was excluded "for vendored
  // templates" until 2026-10-03, when the 65 errors that hid there (all in skills' own scripts
  // and tests, none in a template) were paid down and the exclusion removed; formatting
  // followed on 2026-10-06 (mise.toml fmt:ts).
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["bun"],
    "noEmit": true,
    "allowImportingTsExtensions": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    // `import "x"` with an unresolvable path is an error. Measured 2026-10-03: 0 errors, so it is
    // free. Nothing else catches it here: bun transpiles and never type-checks, and a bad path
    // only fails when that file actually runs (there is no bundler resolving it at build time).
    "noUncheckedSideEffectImports": true,
    // Kept OFF on purpose, measured 2026-10-03: ON is 1345 errors, almost all `process.env.X` ->
    // `process.env["X"]`, for little safety gain (the property is read through an index signature
    // either way). Revisit only if a repo-wide codemod becomes cheap.
    "noPropertyAccessFromIndexSignature": false,
    "allowUnusedLabels": false,
    "allowUnreachableCode": false,
    "useUnknownInCatchVariables": true,

    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["**/*.ts"],
  "exclude": [
    "node_modules",
    // Retired code: nothing links or runs archives/ (see archives/skills/README.md), so it is
    // outside the audit, like node_modules.
    "archives",
    // A symlink to tools/repo-retrieve/src/repo-retrieve.ts. tsgo checks it at the LINK path and
    // resolves its relative imports (./ccc-index.ts, ./child.ts, ../../shared/src/zod.ts) from agents/claude/hooks/,
    // where they do not exist — two false errors. The real file is checked at its own path.
    "agents/claude/hooks/repo-retrieve.ts"
  ]
}
