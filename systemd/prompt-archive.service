[Unit]
Description=Archive new typed prompt history from Claude Code and Codex

[Service]
Type=oneshot
WorkingDirectory=%h/dotfiles
Environment=PATH=%h/.bun/bin:%h/.local/bin:%h/.linuxbrew/bin:/home/linuxbrew/.linuxbrew/bin:/usr/bin:/bin
ExecStart=/usr/bin/env bun %h/dotfiles/tools/prompt-archive/src/prompt-archive.ts
StandardOutput=journal
StandardError=journal
TimeoutStartSec=30s
TimeoutStopSec=5s
