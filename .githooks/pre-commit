#!/bin/sh
# 薄い殻。中身は mise.toml の `hook:pre-commit` にある — フックにロジックを書かない。
# 理由: フックは手で走らせにくく試験もしづらい。task なら `mise run hook:pre-commit` で
# 単体で走らせられ、`mise tasks` に載って発見でき、他の repo と同じ形に揃う。
# mise 不在は警告に落として通す(新しい機械でもコミットはできるべき)。
command -v mise > /dev/null 2>&1 || {
  echo "pre-commit: mise not on PATH; skipping format (run 'mise run f' manually)" >&2
  exit 0
}
exec mise run hook:pre-commit
