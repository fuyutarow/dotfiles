# Gate startup debug logs behind $DOTFILES_DEBUG (export DOTFILES_DEBUG=1 to see them)
_dbg(){ [[ -n "$DOTFILES_DEBUG" ]] && echo "[DEBUG] $*"; }

_dbg "Starting .zprofile (macOS)"

# Homebrew (Apple Silicon)
_dbg "Setting up Homebrew"
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
else
  _dbg "Homebrew not found"
fi

# PATH exports
_dbg "Setting up PATH exports"
# bun global package bins (claude, gemini, this repo's `bin` commands); bun itself comes from
# Homebrew, not ~/.bun. .zshenv already puts both dirs on every shell's PATH (2026-09-13).
# Keep them AFTER Homebrew in login shells too. Standalone CLIs in ~/.local/bin still beat
# stale npm/Bun shims of the same name. Remove inherited copies before appending in that order.
path=("${(@)path:#$HOME/.local/bin}")
path=("${(@)path:#$HOME/.bun/bin}")
path+=("$HOME/.local/bin")
[[ -d "$HOME/.bun/bin" ]] && path+=("$HOME/.bun/bin")


# GNU coreutils (gtimeout etc.)
if [[ -d /opt/homebrew/opt/coreutils/libexec/gnubin ]]; then
  export PATH="/opt/homebrew/opt/coreutils/libexec/gnubin:$PATH"
fi

# Source commands
_dbg "Sourcing cargo env"
if [[ -f "$HOME/.cargo/env" ]]; then
  source "$HOME/.cargo/env"
else
  _dbg "Warning: $HOME/.cargo/env not found"
fi

# fnm removed 2026-08-06 (INV-6, see zsh/zshenv): a second version manager hooking every
# login shell is an implicit global toolchain by construction. Measured before removal —
# `fnm list` held nothing but `* system`, so `fnm env` prepended a PATH entry for zero
# installed nodes and had accumulated 1672 stale dirs under ~/.local/state/fnm_multishells.
# Brewfile.core supplies Node only as Serena's TypeScript language-server runtime.
# Projects that use Node still pin their own version in their mise.toml.
# Do not reintroduce fnm, nvm, volta, or a `mise use -g`; `mise run test:mise-scope` fails.

# Sheldon (load this last)
_dbg "Setting up sheldon"
if command -v sheldon &> /dev/null; then
  eval "$(sheldon source)"
else
  _dbg "Warning: sheldon not found"
  # Fallback: load aliases directly
  _dbg "Loading aliases.zsh directly as fallback"
  if [[ -f "$HOME/dotfiles/zsh/aliases.zsh" ]]; then
    source "$HOME/dotfiles/zsh/aliases.zsh"
  fi
fi

_dbg "Setting up direnv"
if command -v direnv &> /dev/null; then
  eval "$(direnv hook zsh)"
else
  _dbg "Warning: direnv not found"
fi

# bun completions
_dbg "Setting up bun completions"
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# Profiles preserve the workstation default when role.env has not been deployed. Parse its plain
# KEY=value data with zsh builtins; never source the generated file as shell code.
_role_env=${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/role.env
if [[ -r $_role_env ]]; then
  _role_wrapper=''
  while IFS='=' read -r _role_key _role_value; do
    if [[ $_role_key == DOTFILES_ROLE_RUSTC_WRAPPER ]]; then
      _role_wrapper=$_role_value
      break
    fi
  done < $_role_env
  if [[ $_role_wrapper == sccache ]]; then
    export RUSTC_WRAPPER=sccache
  elif [[ $_role_wrapper == none ]]; then
    unset RUSTC_WRAPPER
  fi
  unset _role_wrapper _role_key _role_value
else
  export RUSTC_WRAPPER=sccache
fi
unset _role_env

# Antigravity IDE (macOS-only; guarded so absence is harmless)
if [[ -d "$HOME/.antigravity-ide/antigravity-ide/bin" ]]; then
  export PATH="$HOME/.antigravity-ide/antigravity-ide/bin:$PATH"
fi

# Cargo env and other profile contributors can prepend legacy user bins. Login command shells
# skip zshrc's core precedence pass, so finish the Mac profile with the same Homebrew order.
if [[ -n $HOMEBREW_PREFIX && -x $HOMEBREW_PREFIX/bin/brew ]]; then
  path=("$HOMEBREW_PREFIX/bin" "$HOMEBREW_PREFIX/sbin" "$HOMEBREW_PREFIX/opt/rustup/bin" $path)
fi
typeset -U path PATH

_dbg "Finished .zprofile (macOS)"
