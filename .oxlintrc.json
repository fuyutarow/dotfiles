{
  "extends": ["./presets/typescript/house.oxlintrc.json"],
  "jsPlugins": [
    {
      "name": "house",
      "specifier": "./presets/typescript/house-plugin.js"
    },
    {
      "name": "eslint-js",
      "specifier": "oxlint-plugin-eslint"
    },
    {
      "name": "dotfiles-js",
      "specifier": "./presets/typescript/dotfiles-plugin.js"
    }
  ],
  "ignorePatterns": [
    "node_modules",
    "archives",
    "agents/claude/hooks/repo-retrieve.ts",
    "presets/tests/fixtures",
    "presets/typescript/zod.ts",
    "agents/skills/writing-typescript/assets/consumer-repo",
    "agents/hooks/vendor",
    ".obsidian"
  ],
  "rules": {
    "node/no-sync": [
      "off",
      {
        "allowAtRootLevel": true
      }
    ],
    "dotfiles-js/no-restricted-syntax": [
      "error",
      {
        "selector": ":matches(ImportDeclaration, ExportNamedDeclaration, ExportAllDeclaration)[source.value='zod']",
        "message": "Import `z` (and `jsonOf` for JSON text) from agents/hooks/zod.ts (relative path), the repo's one zod: hooks run before `bun install`, so zod ships as a generated bundle and every file uses that same copy."
      },
      {
        "selector": ":matches(ImportDeclaration, ExportNamedDeclaration, ExportAllDeclaration)[source.value=/^zod\\//]",
        "message": "Import `z` from agents/hooks/zod.ts (relative path), the repo's one zod."
      }
    ]
  },
  "overrides": [
    {
      "files": ["**/tests/**", "**/*.test.ts"],
      "rules": {
        "node/no-sync": "off"
      }
    }
  ]
}
