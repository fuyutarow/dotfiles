install-homebrew:
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

init:
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
    brew install just sheldon
    sudo apt install zsh ;: type q
    ln -s ~/dotfiles/wsl/.zprofile ~
    ln -s ~/dotfiles/common/.zshrc ~
    zsh
    mkdir -p ~/.config
    ln -s ~/dotfiles/common/sheldon ~/.config/sheldon
    brew install topgrade
    topgrade
    chsh -s $(which zsh) ;: Modify login shell

link-dots:
    mkdir -p ~/.config
    ln -sf ~/dotfiles/wsl/.zprofile ~
    ln -sf ~/dotfiles/wsl/.local-gitconfig ~
    ln -sf ~/dotfiles/common/.zshrc ~
    ln -sf ~/dotfiles/common/sheldon ~/.config/sheldon
    ln -sf ~/dotfiles/common/.gitconfig ~
    ln -sf ~/dotfiles/common/.tmux.conf ~

install-rust:
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh

misc:
    git.exe config --global --add safe.directory '%(prefix)///wsl.localhost/Ubuntu-22.04/home/fuyutarow/dotfiles'

install-conda:
    mkdir -p ~/miniconda3
    wget https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh -O ~/miniconda3/miniconda.sh
    bash ~/miniconda3/miniconda.sh -b -u -p ~/.config/conda

# Install recommended CLI tools
install-recommended-tools:
    @echo "📦 Installing recommended CLI tools..."
    # Command replacement tools
    brew install bat         # better cat
    brew install eza         # better ls
    brew install ripgrep     # better grep
    brew install fd          # better find
    brew install dust        # better du
    brew install procs       # better ps
    brew install btop        # better top/htop
    brew install gping       # better ping
    brew install sd          # better sed
    brew install choose-rust # better cut
    brew install tldr        # better man
    brew install zoxide      # better cd
    brew install broot       # better tree
    brew install delta       # better diff
    # Additional useful tools
    brew install just        # command runner
    brew install fzf         # fuzzy finder
    brew install lazygit     # git TUI
    brew install lazydocker  # docker TUI
    brew install jq          # JSON processor
    brew install yq          # YAML processor
    brew install direnv      # directory env manager
    brew install starship    # prompt
    brew install atuin       # shell history sync
    brew install mcfly       # AI-based history
    brew install navi        # interactive cheatsheet
    brew install rip         # safe rm alternative
    @echo "✅ All recommended tools installed!"

# Install tools using cargo (if homebrew fails or for cross-platform)
install-recommended-tools-cargo:
    @echo "📦 Installing recommended CLI tools via cargo..."
    cargo install bat
    cargo install eza
    cargo install ripgrep
    cargo install fd-find
    cargo install du-dust
    cargo install procs
    cargo install bottom      # btop alternative
    cargo install gping
    cargo install sd
    cargo install choose
    cargo install tealdeer    # tldr alternative
    cargo install zoxide
    cargo install broot
    cargo install git-delta
    cargo install just
    cargo install skim        # fzf alternative
    cargo install gitui       # lazygit alternative
    cargo install jaq         # jq alternative
    cargo install starship
    cargo install atuin
    cargo install mcfly
    cargo install navi
    cargo install rm-improved # rip
    @echo "✅ All recommended tools installed via cargo!"

# Show which recommended tools are missing
check-tools:
    @echo "🔍 Checking recommended tools..."
    @command -v bat >/dev/null 2>&1 && echo "✅ bat" || echo "❌ bat (better cat)"
    @command -v eza >/dev/null 2>&1 && echo "✅ eza" || echo "❌ eza (better ls)"
    @command -v rg >/dev/null 2>&1 && echo "✅ ripgrep" || echo "❌ ripgrep (better grep)"
    @command -v fd >/dev/null 2>&1 && echo "✅ fd" || echo "❌ fd (better find)"
    @command -v dust >/dev/null 2>&1 && echo "✅ dust" || echo "❌ dust (better du)"
